{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "extends": ["ultracite"],
  "files": {
    "ignoreUnknown": false,
    "ignore": ["app/routeTree.gen.ts", "app/components/ui/*"],
    "include": ["app/*", ".vscode/*", "index.html", "vite.config.js"]
  },
  "javascript": {
    "formatter": {
      "trailingCommas": "all"
    }
  },
  "linter": {
    "rules": {
      "nursery": {
        "noImgElement": "off"
      }
    }
  }
}
